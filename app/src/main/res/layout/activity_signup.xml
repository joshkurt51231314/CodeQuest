<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:background="@drawable/bg_screen"
    tools:layout_editor_absoluteX="-1dp"
    tools:layout_editor_absoluteY="147dp">

    <TextView
        android:id="@+id/tvSignUpTitle"
        style="@style/PixelText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:background="@drawable/bg_panel"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="25dp"
        android:paddingBottom="23dp"
        android:text="SIGN UP"
        android:textColor="@color/yellow"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.62" />

    <TextView
        android:id="@+id/tvUserLabel"
        style="@style/PixelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="40dp"
        android:text="USERNAME:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSignUpTitle" />

    <EditText
        android:id="@+id/etUsername"
        style="@style/PixelInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="28dp"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvUserLabel" />

    <TextView
        android:id="@+id/tvPassLabel"
        style="@style/PixelText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="20dp"
        android:text="PASSWORD:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etUsername" />

    <FrameLayout
        android:id="@+id/passwordContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="28dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPassLabel">

        <EditText
            android:id="@+id/etPassword"
            style="@style/PixelInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingEnd="72dp"
            tools:layout_editor_absoluteX="27dp"
            tools:layout_editor_absoluteY="422dp" />

        <TextView
            android:id="@+id/tvToggle"
            style="@style/PixelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:padding="6dp"
            android:text="SHOW"
            android:textColor="@color/yellow"
            android:textSize="10sp"
            tools:layout_editor_absoluteX="312dp"
            tools:layout_editor_absoluteY="433dp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvError"
        style="@style/PixelText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="28dp"
        android:gravity="center"
        android:text="ERROR MESSAGE"
        android:textColor="@color/yellow"
        android:textSize="10sp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/passwordContainer"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/btnSignUp"
        style="@style/PixelButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SIGN UP"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvError"
        app:layout_constraintWidth_percent="0.62" />

    <LinearLayout
        android:id="@+id/noteBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:background="@drawable/bg_note"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnSignUp"
        app:layout_constraintWidth_percent="0.72">

        <TextView
            style="@style/PixelText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTE"
            android:textColor="@color/yellow"
            android:textSize="12sp"
            tools:layout_editor_absoluteX="180dp"
            tools:layout_editor_absoluteY="626dp" />

        <TextView
            style="@style/PixelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="TAKE NOTE OF YOUR ACCOUNT DETAILS TO ENSURE ACCOUNT SAFETY"
            android:textSize="9sp"
            tools:layout_editor_absoluteX="71dp"
            tools:layout_editor_absoluteY="649dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
