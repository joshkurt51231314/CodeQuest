<?xml version="1.0" encoding="utf-8"?>
<!-- Crimson gradient + CRT scanlines -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/crimson_bottom"
                android:startColor="@color/crimson_top" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/scanlines"
            android:tileMode="repeat" />
    </item>
</layer-list>
