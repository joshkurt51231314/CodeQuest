<?xml version="1.0" encoding="utf-8"?>
<!-- Black box, light border, hard shadow bottom-right -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="5dp" android:top="5dp">
        <shape android:shape="rectangle"><solid android:color="@color/shadow" /></shape>
    </item>
    <item android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle"><solid android:color="#C0C0C0" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="9dp" android:bottom="9dp">
        <shape android:shape="rectangle"><solid android:color="@color/black" /></shape>
    </item>
</layer-list>
